<h2>Agregar Resultado de Examen</h2>

<form asp-action="AgregarExamen" method="post" enctype="multipart/form-data">

    <input type="hidden" name="pacienteId" value="@ViewBag.PacienteId" />

    <div class="mb-3">
        <label>Descripción</label>
        <textarea class="form-control"
                  name="descripcion"
                  rows="4"
                  required></textarea>
    </div>

    <div class="mb-3">
        <label>Archivo (PDF o imagen)</label>
        <input type="file"
               class="form-control"
               name="archivo"
               required />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

</form>

@if (ViewBag.Error != null)
{
    <div class="text-danger mt-3">
        @ViewBag.Error
    </div>
}