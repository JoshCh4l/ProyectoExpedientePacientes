@using ProyectoExpedientePacientes.Models

<h2>Expediente del Paciente</h2>

<hr />

<!-- ================= Padecimientos ================= -->

<h3>Padecimientos</h3>

<form asp-action="AgregarPadecimiento" method="post" class="mb-3">

    <input type="hidden"
           name="pacienteId"
           value="@ViewBag.PacienteId" />

    <div class="row">

        <div class="col-md-10">
            <select name="padecimientoId" class="form-select">
                @foreach (var p in (List<Padecimiento>)ViewBag.Padecimientos)
                {
                    <option value="@p.Id">@p.Nombre</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit"
                    class="btn btn-primary w-100">
                Agregar
            </button>
        </div>

    </div>

</form>

<table class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>Padecimiento</th>
            <th>Médico</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var p in (List<PadecimientoPaciente>)ViewBag.PadecimientosPaciente)
        {
            <tr>

                <td>@p.Padecimiento.Nombre</td>

                <td>@p.Usuario.Nombre</td>

                <td>@p.FechaRegistro</td>

                <td>
                    @(p.Suspendido ? "Suspendido" : "Activo")
                </td>

                <td>

                    @if (!p.Suspendido)
                    {
                        <a asp-action="SuspenderPadecimiento"
                           asp-route-id="@p.Id"
                           class="btn btn-danger btn-sm">
                            Suspender
                        </a>
                    }

                </td>

            </tr>
        }

    </tbody>

</table>

<hr />

