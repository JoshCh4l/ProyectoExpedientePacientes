<!-- ================= Resultados de Exámenes ================= -->

<h3>Resultados de Exámenes</h3>

<a asp-action="AgregarExamen"
   asp-route-id="@ViewBag.PacienteId"
   class="btn btn-primary mb-3">
    Agregar Examen
</a>

<table class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>Descripción</th>
            <th>Médico</th>
            <th>Fecha</th>
            <th>Archivo</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var e in (List<ResultadoExamenMedico>)ViewBag.Examenes)
        {
            <tr>

                <td>@e.Descripcion</td>

                <td>@e.Usuario.Nombre</td>

                <td>@e.FechaRegistro</td>

                <td>

                    <a asp-action="VerExamen"
                       asp-route-id="@e.Id"
                       class="btn btn-success btn-sm">
                        Ver Archivo
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>