@model IEnumerable<ProyectoExpedientePacientes.Models.NotaClinica>

<h1>Historial Clínico</h1>

<a asp-action="AgregarNota" asp-route-id="@ViewBag.PacienteId" class="btn btn-primary">
    Agregar Nota Clinica
</a>

<table id="tablaHistorial" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Medico</th>
            <th>Contenido</th>
            <th>Fecha y Hora</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var nota in Model)
        {
            <tr>
                <td>@nota.UsuarioId</td>
                <td>@(nota.Usuario.MedicoId?.ToString() ?? "-- Hecho_Por_Administrador --")</td>
                <td>@nota.Contenido</td>
                <td>@nota.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>
</div>

@section Scripts {

    <script>
        $(document).ready(function(){
            $('#tablaHistorial').DataTable({
                lenguage: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
                }
            });
        });
    </script>
}