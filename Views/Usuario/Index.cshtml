@model IEnumerable<ProyectoExpedientePacientes.Models.Usuario>

<h1>Listado de Usuarios</h1>

<a class="btn btn-primary mb-3" href="@Url.Action("Agregar", "Usuario")">
    Agregar Usuario
</a>

<table id="tablaUsuarios" class="table table-striped table-bordered" >
    <thead>
        <tr>
            <th>Id</th>
            <th>Cédula</th>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Bloqueado</th>
            <th>Médico</th>
            <th>Paciente</th>
            <th>Bloquear/Desbloquear</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var usuario in Model)
        {
            <tr>
                <td>@usuario.Id</td>
                <td>@usuario.Cedula</td>
                <td>@usuario.Nombre</td>
                <td>@usuario.Correo</td>
                <td>@usuario.Rol</td>
                <td>
                    @(usuario.Bloqueado ? "Sí" : "No")
                </td>
                <td>
                    @if (usuario.Medico != null)
                    {
                        @usuario.MedicoId
                    }
                    else
                    {
                        @:-
                    }
                </td>
                <td>
                    @if (usuario.Paciente != null)
                    {
                        @usuario.PacienteId
                    }
                    else
                    {
                        @:-
                    }

                </td>
                <td>
                    @if (usuario.Bloqueado)
                    {
                        <a asp-action="CambiarEstado"
                           asp-route-id="@usuario.Id"
                           class="btn btn-success btn-sm">
                            Desbloquear
                        </a>
                    }
                    else
                    {
                        <a asp-action="CambiarEstado"
                           asp-route-id="@usuario.Id"
                           class="btn btn-warning btn-sm">
                            Bloquear
                        </a>
                    }
                </td>
                <td>
                    <a asp-action="Modificar"
                       asp-route-id="@usuario.Id"
                       class="btn btn-warning btn-sm">
                        Modificar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@usuario.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
                
            </tr>
        }
    </tbody>
</table>

@section Scripts{
    <script>
        $(document).ready(function(){
            $('#tablaUsuarios').DataTable({
                lenguage: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
                }
            });
        });
    </script>
}


