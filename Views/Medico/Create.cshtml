@model ProyectoExpedientePacientes.Models.Medico

@{
    ViewData["Title"] = "Crear Médico";

    var especialidades =
        ViewBag.Especialidades as List<ProyectoExpedientePacientes.Models.Especialidad>;
}

<h2>Crear Médico</h2>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="NombreCompleto" class="form-label"></label>

        <input asp-for="NombreCompleto"
               class="form-control"
               autocomplete="off" />

        <span asp-validation-for="NombreCompleto"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NumeroColegiado"
               class="form-label"></label>

        <input asp-for="NumeroColegiado"
               class="form-control"
               autocomplete="off" />

        <span asp-validation-for="NumeroColegiado"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">
            Fotografía
        </label>

        <input type="file"
               name="foto"
               class="form-control" />
    </div>

    <div class="mb-3">

        <label class="form-label">
            Especialidades
        </label>

        @foreach (var esp in especialidades)
        {
            <div class="form-check">

                <input class="form-check-input"
                       type="checkbox"
                       name="especialidadesSeleccionadas"
                       value="@esp.Id" />

                <label class="form-check-label">
                    @esp.Nombre
                </label>

            </div>
        }

    </div>

    <button type="submit"
            class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}