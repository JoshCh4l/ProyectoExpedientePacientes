@model ProyectoExpedientePacientes.Models.Medico

<h2>Eliminar Médico</h2>

<h4>
    ¿Desea eliminar al médico
    @Model.NombreCompleto?
</h4>

<form asp-action="Delete">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">

        Eliminar

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Cancelar

    </a>

</form>