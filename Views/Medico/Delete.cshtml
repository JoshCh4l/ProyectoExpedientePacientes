@model ProyectoExpedientePacientes.Models.Medico

<h2>¿Está seguro de eliminar este médico?</h2>

<br />

<h4>
    <strong>Nombre:</strong>
    @Model.NombreCompleto
</h4>

<br />

<h4>
    <strong>Número Colegiado:</strong>
    @Model.NumeroColegiado
</h4>

<br />

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Confirmar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>