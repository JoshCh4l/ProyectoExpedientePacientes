@model IEnumerable<ProyectoExpedientePacientes.Models.Medico>

<h1>Listado de Médicos</h1>

<a class="btn btn-primary mb-3"
   href="@Url.Action("Create", "Medico")">
    Agregar Médico
</a>

<table id="tablaMedicos"
       class="table table-striped table-bordered">

    <thead>
        <tr>
            <th>Nombre</th>
            <th>Número Colegiado</th>
            <th>Especialidades</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var medico in Model)
        {
            <tr>
                <td>@medico.NombreCompleto</td>

                <td>@medico.NumeroColegiado</td>

                <td>
                    @string.Join(", ",
                    medico.MedicoEspecialidades
                    .Select(me => me.Especialidad.Nombre))
                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@medico.Id"
                       class="btn btn-warning btn-sm">
                        Modificar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@medico.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>

                </td>

            </tr>
        }
    </tbody>

</table>

@section Scripts
{
    <script>
        $(document).ready(function () {

            $('#tablaMedicos').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
                }
            });

        });
    </script>
}