@model IEnumerable<ProyectoExpedientePacientes.Models.Padecimiento>

<h1>Listado de Padecimientos</h1>

<a class="btn btn-primary mb-3" href="@Url.Action("Agregar", "Padecimiento")">
    Agregar Padecimiento
</a>

<table id="tablaPadecimientos" class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var padecimiento in Model)
        {
            <tr>
                <td>@padecimiento.Id</td>
                <td>@padecimiento.Nombre</td>
                <td>@padecimiento.Descripcion</td>
                <td>
                    <a asp-action="Modificar"
                       asp-route-id="@padecimiento.Id"
                       class="btn btn-warning btn-sm">
                        Modificar
                    </a>

                    <a asp-action="Eliminar"
                       asp-route-id="@padecimiento.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function(){
            $('#tablaPadecimientos').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json'
                }
            });
        });
    </script>
}