@model ProyectoExpedientePacientes.Models.Especialidad

<h2>Estas seguro de eliminar esta especialidad?</h2>
<br />

<h4><strong>ID:</strong> @Model.Id</h4>
<br />

<h4><strong>Nombre:</strong> @Model.Nombre</h4>
<br />

<form asp-action="Eliminar" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Confirmar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

</form>